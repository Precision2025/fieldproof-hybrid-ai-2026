# Public client-side Firebase Web App configuration for this contest project.
# NEVER place service account credentials, private keys, recaptcha *secret* keys, or debug App Check tokens here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# public App Check key; "enterprise" recommended or "v3" for classic reCAPTCHA.
VITE_APPCHECK_PROVIDER=enterprise
VITE_APPCHECK_RECAPTCHA_SITE_KEY=